# Sovereign AI Workbench — Backend Environment Template
SAW_HOST=127.0.0.1
SAW_PORT=8000
SAW_DEBUG=false

# Local LLM Provider (llama.cpp server)
SAW_LLM_ENABLED=true
SAW_LLM_PROVIDER=llama_cpp
SAW_LLM_BASE_URL=http://127.0.0.1:8080
SAW_LLM_MODEL_ID=gemma-3-4b-it
SAW_LLM_TIMEOUT=120

# Knowledge Base & Vector Settings
SAW_EMBEDDING_PROVIDER=tfidf
SAW_EMBEDDING_DIMENSION=512
SAW_RETRIEVAL_TOP_K=5
SAW_SIMILARITY_THRESHOLD=0.05

# Audit and Data Storage
SAW_DATA_DIR=data
SAW_AUDIT_LOG_FILE=data/audit.log
